# ==============================================================================
# Vertex Digitals — AI Agency 2027 Environment Configuration
# Copy this file to `.env.local` for local development and configure the same
# keys in Vercel Project Settings -> Environment Variables for production.
#
# SECURITY NOTES:
# - Only `NEXT_PUBLIC_*` variables are exposed to browser JavaScript.
# - NEVER expose `SUPABASE_SERVICE_ROLE_KEY`, webhook secrets, or `ADMIN_EMAIL`.
# - NEVER store an admin password here. Create the admin user in Supabase Auth.
# ==============================================================================

# Public Site & Contact Metadata (Browser-safe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=support@vertexdigitals.example

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Dashboard Authorization (Server-only; never add an admin password here)
ADMIN_EMAIL=afnankhan6381@gmail.com

# Live Launch Offer Configuration (Server-only)
# Founding pricing applies to the first 50 verified paid orders.
LAUNCH_BUYER_LIMIT=50
# Optional ISO-8601 UTC end timestamp for a real countdown timer.
# Leave blank to display only the verified 50-buyer limit without any countdown.
LAUNCH_END_AT=
# Used only in the admin dashboard to estimate combined INR+USD revenue display.
USD_TO_INR_RATE=85

# Razorpay Configuration — India Market (Server-only)
# Replace placeholder URLs with your real Razorpay Payment Page / Payment Link URLs.
RAZORPAY_LAUNCH_CHECKOUT_URL=https://pages.razorpay.com/placeholder-ai-agency-2027-launch
RAZORPAY_STANDARD_CHECKOUT_URL=https://pages.razorpay.com/placeholder-ai-agency-2027-regular
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Gumroad Configuration — International Market (Server-only)
# Replace placeholder URLs with your real Gumroad product checkout URLs.
GUMROAD_LAUNCH_CHECKOUT_URL=https://vertexdigitals.gumroad.com/l/placeholder-ai-agency-2027-launch
GUMROAD_STANDARD_CHECKOUT_URL=https://vertexdigitals.gumroad.com/l/placeholder-ai-agency-2027-regular
GUMROAD_WEBHOOK_SECRET=your-gumroad-webhook-secret
# Optional Gumroad seller_id to additionally verify incoming Gumroad Ping payloads
GUMROAD_SELLER_ID=
